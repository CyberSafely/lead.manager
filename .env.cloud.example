# Copy to .env.cloud and fill in. (.env.cloud is git-ignored; this example file is committed, so never put real values here.)
# Project Settings → API Keys → publishable key. Meant to be public: row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# Scripts only (schema + migration), never shipped to the browser.
# Either the full connection string (Project Settings → Database → Connection string → Session pooler) …
SUPABASE_DB_URL=
# … or just the database password, and the scripts build the connection.
DATABASE_PASSWORD=
